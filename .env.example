# API Keys (fill with real values)
S2PRO_API_KEY=your_fish_audio_api_key_here
VOXTRAL_API_KEY=your_mistral_api_key_here
QWEN3_API_KEY=your_dashscope_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Voxtral: bereits erstellte Voice ID (aus create_voice)
VOXTRAL_VOICE_ID=your_voxtral_voice_id_here

# Fish Audio (S2-Pro): Reference/Model ID
S2PRO_REFERENCE_ID=your_fish_reference_id_here
# "balanced" streamt das Audio (TTFA messbar), "normal" = ein Frame, beste Qualitaet
S2PRO_LATENCY_MODE=balanced

# Qwen3 (DashScope): bereits erstellte Voice ID (aus qwen_voice_enroll.py create)
QWEN3_VOICE_ID=your_qwen3_voice_id_here
# Realtime voice-clone model the voice was enrolled against
QWEN3_REALTIME_MODEL=qwen3-tts-vc-realtime-2026-01-15
# Sprach-Hinweis fuer die Synthese (leer lassen fuer auto-detect)
QWEN3_LANGUAGE_TYPE=de

# DashScope (Qwen3) host — leave empty/default for shared dashscope.aliyuncs.com,
# or set to your dedicated per-workspace host (see "API Host" in the console's API-Key dialog)
QWEN3_API_HOST=dashscope.aliyuncs.com
